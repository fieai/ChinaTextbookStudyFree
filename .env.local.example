# 复制为仓库根目录 .env.local。不要提交真实 API key；不要把它写进命令参数。
ELEVENLABS_API_KEY=
# 从 ElevenLabs 声音库取得 voice id；真实生成必填，dry-run 可留空。
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4
# 普通话默认 zh；设为空可关闭语言指定。eleven_multilingual_v2 不支持此参数。
ELEVENLABS_LANGUAGE_CODE=zh
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# 儿童朗读默认值；可在试听后调整。所有配置参与缓存键。
ELEVENLABS_SPEED=0.85
ELEVENLABS_STABILITY=0.65
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0
ELEVENLABS_USE_SPEAKER_BOOST=true
